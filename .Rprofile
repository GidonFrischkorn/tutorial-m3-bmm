if (interactive()) {
  if (!requireNamespace("pacman", quietly = TRUE)) {
    message("The scripts load packages with pacman. Install it with:")
    message('  install.packages("pacman")')
  }
  if (!requireNamespace("cmdstanr", quietly = TRUE)) {
    message("cmdstanr is not installed. Install it with:")
    message('  install.packages("cmdstanr", repos = c("https://stan-dev.r-universe.dev", getOption("repos")))')
  }
}
